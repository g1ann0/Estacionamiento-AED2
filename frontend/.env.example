# ========================================
# Variables de Entorno - Frontend
# ========================================
# Copiar este archivo como .env en la carpeta frontend/

# ==========================================
# API BACKEND
# ==========================================
REACT_APP_API_URL=http://localhost:3000

# Para Docker:
# REACT_APP_API_URL=http://localhost:3000

# Para producción:
# REACT_APP_API_URL=https://api.tudominio.com

# ==========================================
# GOOGLE ANALYTICS
# ==========================================
# Obtener Measurement ID en https://analytics.google.com/
# Formato: G-XXXXXXXXXX
REACT_APP_GA_TRACKING_ID=

# Habilitar modo debug en desarrollo
REACT_APP_GA_DEBUG=true

# ==========================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ==========================================
REACT_APP_NAME=Sistema de Estacionamiento
REACT_APP_VERSION=1.0.0

# ==========================================
# FEATURE FLAGS (opcional)
# ==========================================
# Habilitar/deshabilitar funcionalidades

# Facturación AFIP
REACT_APP_ENABLE_AFIP=true

# Google Analytics
REACT_APP_ENABLE_ANALYTICS=true

# Modo mantenimiento
REACT_APP_MAINTENANCE_MODE=false

# ==========================================
# MAPAS Y GEOLOCALIZACIÓN (futuro)
# ==========================================
# REACT_APP_GOOGLE_MAPS_API_KEY=
# REACT_APP_MAPBOX_TOKEN=

# ==========================================
# PAGOS (futuro)
# ==========================================
# REACT_APP_MERCADOPAGO_PUBLIC_KEY=
# REACT_APP_STRIPE_PUBLIC_KEY=
