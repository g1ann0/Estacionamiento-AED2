# ========================================
# Variables de Entorno para Docker Compose
# ========================================
# Copiar este archivo como .env en la raíz del proyecto

# ==========================================
# AMBIENTE
# ==========================================
NODE_ENV=development
# Opciones: development | production

# ==========================================
# SEGURIDAD
# ==========================================
# IMPORTANTE: Cambiar este secreto en producción
# Generar uno seguro con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=tu_secreto_super_seguro_cambiar_en_produccion
JWT_EXPIRATION=7d

# ==========================================
# AFIP - Facturación Electrónica
# ==========================================
AFIP_CUIT=
AFIP_PRODUCTION=false
AFIP_CERT_PATH=
AFIP_KEY_PATH=

# ==========================================
# LOGS
# ==========================================
LOG_LEVEL=info
# Opciones: error | warn | info | debug

# ==========================================
# FRONTEND
# ==========================================
REACT_APP_API_URL=http://localhost:3000/api

# Google Analytics (obtener en https://analytics.google.com)
REACT_APP_GA_TRACKING_ID=

# ==========================================
# PUERTOS (opcional - para desarrollo)
# ==========================================
# Descomentar para cambiar puertos por defecto
# BACKEND_PORT=3000
# FRONTEND_PORT=80
# MONGODB_PORT=27017
