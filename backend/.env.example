PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/estacionamientoDB
JWT_SECRET=
NODE_ENV=development

# Límite de intentos en la superficie sin token (login, recuperación, alta). Ponerlo en true
# apaga los límites: sirve para desarrollo y para los scripts de verificación, que hacen
# decenas de logins seguidos a propósito. En producción se deja apagada esta variable.
RATE_LIMIT_OFF=false

# Dónde vive el frontend. Los mails de verificación y de recuperación arman sus links con esto:
# si queda en localhost, el link que le llega al cliente apunta a la máquina del cliente.
APP_URL=http://localhost:3001

# Orígenes extra permitidos por CORS, separados por coma (el dominio de producción va acá).
# Los de red local ya están contemplados en el código.
CORS_ORIGINS=

# SMTP para verificación de cuenta y recuperación de contraseña
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
# Remitente de los correos. Si se omite, se usa SMTP_USER.
SMTP_FROM=

# ARCA (ex AFIP) — facturación electrónica, Etapa 6.
# El ambiente es explícito y no se infiere de NODE_ENV: produccion emite comprobantes
# fiscales reales, que no se borran, solo se anulan con nota de crédito.
ARCA_AMBIENTE=homologacion
ARCA_CUIT=
# Las rutas se resuelven solas: certs/arca-<ambiente>.crt y certs/arca.key.
# Los dos certificados salen del MISMO CSR, así que la clave privada es una sola.
# Se pueden forzar con ARCA_CERT_PATH y ARCA_KEY_PATH.
# Solo si la .key está cifrada, o si en vez del par usás un .p12.
ARCA_CERT_PASSWORD=
# Andamio de desarrollo: devuelve un CAE falso para recorrer el circuito sin certificado.
# Nunca en produccion — PRODUCT.md fija ARCA real, sin mock permanente.
ARCA_MOCK=false
# Reconciliación automática con ARCA (Tarea 6.2), en milisegundos. 0 la apaga y deja solo la
# corrida manual desde el panel. Por defecto, cada 6 horas.
ARCA_RECONCILIACION_INTERVALO_MS=21600000
