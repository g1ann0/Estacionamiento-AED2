PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/estacionamientoDB
JWT_SECRET=
NODE_ENV=development

# SMTP para verificación de cuenta y recuperación de contraseña
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=

# ARCA (ex AFIP) — facturación electrónica, Etapa 6.
# El ambiente es explícito y no se infiere de NODE_ENV: produccion emite comprobantes
# fiscales reales, que no se borran, solo se anulan con nota de crédito.
ARCA_AMBIENTE=homologacion
ARCA_CUIT=
# Las rutas se resuelven solas: certs/arca-<ambiente>.crt y certs/arca.key.
# Los dos certificados salen del MISMO CSR, así que la clave privada es una sola.
# Se pueden forzar con ARCA_CERT_PATH y ARCA_KEY_PATH.
# Solo si la .key está cifrada, o si en vez del par usás un .p12.
ARCA_CERT_PASSWORD=
# Andamio de desarrollo: devuelve un CAE falso para recorrer el circuito sin certificado.
# Nunca en produccion — PRODUCT.md fija ARCA real, sin mock permanente.
ARCA_MOCK=false
