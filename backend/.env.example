# ========================================
# CONFIGURACIÓN AFIP/ARCA - FACTURACIÓN ELECTRÓNICA
# ========================================

# CUIT del emisor (estacionamiento) - OBLIGATORIO
# Formato: 11 dígitos numéricos sin guiones
# Ejemplo: 20123456789
AFIP_CUIT=

# Modo de operación
# true = PRODUCCIÓN (requiere certificados reales)
# false = HOMOLOGACIÓN/TESTING (ambiente de pruebas)
AFIP_PRODUCTION=false

# Ruta al certificado X.509 (.pem) emitido por AFIP
# Solo requerido en PRODUCCIÓN
# Dejar vacío para ambiente de testing
AFIP_CERT_PATH=

# Ruta a la clave privada (.key) correspondiente al certificado
# Solo requerido en PRODUCCIÓN
# Dejar vacío para ambiente de testing
AFIP_KEY_PATH=

# Token de acceso para servicios adicionales de Afip SDK (opcional)
# Puede dejarse vacío para funcionalidad básica
AFIP_ACCESS_TOKEN=

# ========================================
# CONFIGURACIÓN EXISTENTE
# ========================================

# MongoDB
MONGODB_URI=mongodb://localhost:27017/estacionamiento_db

# JWT
JWT_SECRET=tu_secreto_super_seguro_cambialo_en_produccion

# Puerto del servidor
PORT=3000

# Entorno
NODE_ENV=development

# ========================================
# CONFIGURACIÓN DE EMAIL (Para notificaciones)
# ========================================

# Servidor SMTP (Gmail, Outlook, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Credenciales del email
# Para Gmail: Usa una "contraseña de aplicación" no tu contraseña normal
# Ver: https://support.google.com/accounts/answer/185833
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion
