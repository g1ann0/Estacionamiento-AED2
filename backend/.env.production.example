# Plantilla del entorno de PRODUCCIÓN. Copiar como `.env` en el servidor y completar.
# Ninguna de estas variables tiene un valor por defecto seguro: si falta una, o el sistema no
# arranca, o arranca haciendo algo distinto de lo que se espera. Ver docs/despliegue-produccion.md.

NODE_ENV=production
PORT=3000

# Base de datos. Tiene que ser un REPLICA SET (aunque sea de un solo nodo): sin él, Mongo
# rechaza las transacciones y el sistema degrada a escrituras sueltas — un cobro son cinco.
# La cadena de conexión debe incluir el nombre del conjunto.
MONGODB_URI=mongodb://127.0.0.1:27017/estacionamientoDB?replicaSet=rs0

# Secreto de firma de los tokens. GENERAR UNO NUEVO, nunca reutilizar el de desarrollo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Cambiarlo invalida todas las sesiones abiertas, que es justo lo que se busca al rotarlo.
JWT_SECRET=

# Dónde vive el frontend, sin barra final. Los correos de verificación y de recuperación arman
# sus links con esto: si queda en localhost, el link que recibe el cliente no funciona.
APP_URL=https://

# Orígenes permitidos por CORS, separados por coma. Si el frontend se sirve desde el mismo
# Express (NODE_ENV=production sirve frontend/build), puede quedar vacío.
CORS_ORIGINS=

# El límite de intentos SIEMPRE encendido en producción. `true` acá deja el login sin freno.
RATE_LIMIT_OFF=false

# Correo saliente.
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Estacionamiento <no-reply@tu-dominio.com>

# ---------------------------------------------------------------------------- ARCA --
# `produccion` emite comprobantes fiscales REALES: no se borran, se anulan con nota de
# crédito. El ambiente es explícito y no se deduce de NODE_ENV, justamente por eso.
ARCA_AMBIENTE=produccion
ARCA_CUIT=
# Certificado y clave se resuelven solos: certs/arca-produccion.crt y certs/arca.key.
# Nunca van al repositorio (.gitignore los cubre).
ARCA_CERT_PASSWORD=
# En producción va en false, siempre. `true` inventa un CAE que no existe ante ARCA.
ARCA_MOCK=false
# Reconciliación automática con ARCA, en milisegundos. 0 la apaga.
ARCA_RECONCILIACION_INTERVALO_MS=21600000
